# --- Groq API (kept for reference; not used when GENERATION_BACKEND=ollama) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Local LLM (Ollama) ---
# Backend selector: "ollama" (default) or "groq"
GENERATION_BACKEND=ollama

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model tag — must be pulled first: ollama pull qwen2.5:7b
# Hardware guidance:
#   RTX 4050 6GB VRAM + 16GB RAM  ->  qwen2.5:7b (Q4_K_M, ~4.5GB VRAM)
#   RTX 4060+ 8GB VRAM            ->  qwen2.5:14b
#   CPU-only / 16GB RAM           ->  qwen2.5:3b or phi3.5:3.8b
OLLAMA_MODEL=qwen2.5:7b

# Generation settings (apply to both backends)
GENERATION_TEMPERATURE=0.0
GENERATION_MAX_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=180
